<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Allow user-installed CAs for debugging only.
      In production, only system CAs are trusted (the default).
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Domain-specific config for Hugging Face downloads.
      Uses system CAs only — no certificate pinning yet because HF uses
      a CDN with rotating certificates. Pinning will be added when the
      download endpoint is stabilized.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">hf.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
