<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (android:dataExtractionRules).

    Model files and download partials are excluded from both cloud backup and
    device-to-device transfer — they are large, rebuildable artifacts. The Room
    database (conversations) transfers normally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="models/" />
        <exclude
            domain="file"
            path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="models/" />
        <exclude
            domain="file"
            path="downloads/" />
    </device-transfer>
</data-extraction-rules>
