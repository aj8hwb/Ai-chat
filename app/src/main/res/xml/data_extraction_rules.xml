<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (android:dataExtractionRules).

    Privacy-first backup policy:
    - Model files and download partials: excluded (large, rebuildable)
    - Room database (conversations, messages): excluded (privacy-sensitive)
    - Settings (DataStore): included (user preferences)
    - Crash logs: excluded (diagnostic data)

    This ensures "100% data never leaves device" claim is technically accurate.
    Users can export conversations manually via the export feature.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="models/" />
        <exclude
            domain="file"
            path="downloads/" />
        <exclude
            domain="database"
            path="AiDatabase" />
        <exclude
            domain="file"
            path="crash_log.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="models/" />
        <exclude
            domain="file"
            path="downloads/" />
        <exclude
            domain="database"
            path="AiDatabase" />
        <exclude
            domain="file"
            path="crash_log.txt" />
    </device-transfer>
</data-extraction-rules>
